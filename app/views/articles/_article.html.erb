<div id="<%= dom_id article %>">
  <p>
    <strong><%= t('.title') %>:</strong>
    <%= article.title %>
  </p>

  <p>
    <strong><%= t('.body') %>:</strong>
    <%= article.body %>
  </p>

  <p>
    <strong><%= t('.published') %>:</strong>
    <%= article.published? ? t('.yes') : t('.no') %>
  </p>

</div>
