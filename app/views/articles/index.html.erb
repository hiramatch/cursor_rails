<p style="color: green"><%= notice %></p>

<% content_for :title, t('.page_title') %>

<h1><%= t('.page_title') %></h1>

<div id="articles">
  <% @articles.each do |article| %>
    <%= render article %>
    <p>
      <%= link_to t('.show_article'), article %>
    </p>
  <% end %>
</div>

<%= link_to t('.new_article'), new_article_path %>
