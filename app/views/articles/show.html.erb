<% if notice %>
  <div class="notice"><%= notice %></div>
<% end %>

<div class="article-detail">
  <div class="article-detail-header">
    <h1 class="article-detail-title"><%= @article.title %></h1>
    
    <div class="article-detail-meta">
      <span class="article-status <%= @article.published? ? 'published' : 'draft' %>">
        <%= @article.published? ? t('common.yes') : t('common.no') %>
      </span>
      <small><%= @article.created_at.strftime("%Y年%m月%d日") %></small>
    </div>
  </div>

  <div class="article-detail-body">
    <%= simple_format(@article.body) %>
  </div>

  <div class="article-detail-actions">
    <%= link_to t('.edit_article'), edit_article_path(@article), class: "btn btn-primary" %>
    <%= link_to t('.back_to_articles'), articles_path, class: "btn btn-secondary" %>
    
    <%= button_to t('.destroy_article'), @article, 
                  method: :delete, 
                  class: "btn btn-danger",
                  data: { confirm: t('.confirm_destroy') } %>
  </div>
</div>
